<?xml version="1.0" encoding="UTF-8"?>
<!--
  hackbot — concept map v1 (overview)
  Format: CXL (Concept Map Extensible Language), IHMC CmapTools.
  Open with CmapTools (https://cmap.ihmc.us/) via File -> Open.
  Every edge reads as a proposition: concept -> linking phrase -> concept.
-->
<cmap xmlns="http://cmap.ihmc.us/xml/cmap/"
      xmlns:dc="http://purl.org/dc/elements/1.1/">

    <res-meta>
        <dc:title>hackbot — mind map v1 (overview)</dc:title>
        <dc:description>What is hackbot and how is it built?</dc:description>
        <dc:subject>hackbot, Go, nmap, security, concept map, v1</dc:subject>
        <dc:creator><vcard:FN xmlns:vcard="http://www.w3.org/2001/vcard-rdf/3.0#">hackbot project</vcard:FN></dc:creator>
        <dc:format>x-cmap/text-xml</dc:format>
        <dc:publisher>IHMC CmapTools</dc:publisher>
    </res-meta>

    <map root-id="c1"
         header="hackbot — mind map v1 (overview)"
         footer="github.com/rjwashi/hackbot — format: CmapTools CXL">

        <!-- ============================ CONCEPTS ============================ -->
        <concept-list>
            <concept id="c1" label="hackbot"
                     long-comment="Root concept. hackbot is a Go-first bot project with a small Python escape hatch. Its current focus is the nmap risk agent: turning network scans into prioritized, actionable findings."/>
            <concept id="c2" label="WHAT IT IS"/>
            <concept id="c3" label="a Go-first bot project with a Python escape hatch"/>
            <concept id="c4" label="github.com/rjwashi/hackbot (public, main)"/>
            <concept id="c5" label="the hackbot CLI binary"/>
            <concept id="c6" label="WHY"/>
            <concept id="c7" label="turn nmap scans into prioritized, actionable risk findings"/>
            <concept id="c8" label="CLI SURFACE"/>
            <concept id="c9" label="hello · run · version · help"/>
            <concept id="c10" label="py &lt;helper&gt; (Go → Python bridge)"/>
            <concept id="c11" label="nmap subcommands"/>
            <concept id="c12" label="parse · analyze · scan · pipeline"/>
            <concept id="c13" label="flags: -json · -llm · -issues · -dry-run · -repo · -min-severity · -max-issues"/>
            <concept id="c14" label="CODE MAP (internal/)"/>
            <concept id="c15" label="config/"/>
            <concept id="c16" label="bot/"/>
            <concept id="c17" label="nmap/"/>
            <concept id="c18" label="scan/"/>
            <concept id="c19" label="agent/"/>
            <concept id="c20" label="JSON file + HACKBOT_* env → Config struct"/>
            <concept id="c21" label="core loop (greet/tick/done) + RunPython()"/>
            <concept id="c22" label="XML parse + rule-based Analyze() → []Finding"/>
            <concept id="c23" label="guarded nmap runner + InScope()"/>
            <concept id="c24" label="pipeline: analyze → [LLM] → [issues]; Report"/>
            <concept id="c25" label="DATA FLOW"/>
            <concept id="c26" label="nmap XML input or guarded scan"/>
            <concept id="c27" label="nmap.Scan"/>
            <concept id="c28" label="[]Finding (ranked worst-first)"/>
            <concept id="c29" label="LLM narrative"/>
            <concept id="c30" label="GitHub issues (dry-run default)"/>
            <concept id="c31" label="SAFETY MODEL"/>
            <concept id="c32" label="scanning DISABLED by default"/>
            <concept id="c33" label="allowlist REQUIRED (IP/CIDR only)"/>
            <concept id="c34" label="hostnames refused; scope cannot widen"/>
            <concept id="c35" label="issue creation DRY-RUN by default"/>
            <concept id="c36" label="ingestion is the default mode"/>
            <concept id="c37" label="CONFIGURATION"/>
            <concept id="c38" label="-config hackbot.json (see hackbot.example.json)"/>
            <concept id="c39" label="HACKBOT_* environment variables"/>
            <concept id="c40" label="QUALITY"/>
            <concept id="c41" label="Go tests (nmap, scan, agent, config, bot, main)"/>
            <concept id="c42" label="Python tests (pytest, 9 passing)"/>
            <concept id="c43" label="CI: gofmt + vet + build + test -race + pytest"/>
            <concept id="c44" label="ROADMAP"/>
            <concept id="c45" label="issue #1: define hackbot's first real feature"/>
            <concept id="c46" label="issue #2: nmap agent hardening"/>
            <concept id="c47" label="more ingest formats (-oG / normal)"/>
            <concept id="c48" label="pluggable rule sets (YAML/JSON)"/>
            <concept id="c49" label="CVE enrichment from CPEs"/>
            <concept id="c50" label="scan-to-scan diffing (newly opened ports)"/>
            <concept id="c51" label="scheduler + change-based alerts"/>
        </concept-list>

