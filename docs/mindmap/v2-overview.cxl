<!--
  hackbot — concept map v2 (overview, annotated)
  Format: CXL (Concept Map Extensible Language), IHMC CmapTools.
  Open with CmapTools (https://cmap.ihmc.us/) via File -> Open.
  Every edge reads as a proposition: concept -> linking phrase -> concept.
  Generated by docs/mindmap/build.py — edit that file, then re-run it.
-->
<cmap xmlns="http://cmap.ihmc.us/xml/cmap/"
      xmlns:dc="http://purl.org/dc/elements/1.1/">

    <res-meta>
        <dc:title>hackbot — mind map v2 (overview, annotated)</dc:title>
        <dc:description>What hackbot is, what it does, and why it is built this way?</dc:description>
        <dc:subject>hackbot, Go, security agents, WSTG, recon, nmap, concept map, v2</dc:subject>
        <dc:creator><vcard:FN xmlns:vcard="http://www.w3.org/2001/vcard-rdf/3.0#">hackbot project</vcard:FN></dc:creator>
        <dc:format>x-cmap/text-xml</dc:format>
        <dc:publisher>IHMC CmapTools</dc:publisher>
    </res-meta>

    <map root-id="c1"
         header="hackbot — mind map v2 (overview, annotated)"
         footer="github.com/rjwashi/hackbot — format: CmapTools CXL (generated)">

        <!-- ============================ CONCEPTS ============================ -->
        <concept-list>
            <concept id="c1" label="hackbot"
                     long-comment="Root concept. hackbot is a Go-first security toolkit with a small Python escape hatch. It wraps free/open-source tools behind one CLI, treats each capability as an &#x27;agent&#x27;, and forces every active action through a two-gate safety model (enable + allowlist). This is map v2: it reflects the five shipped agent families (nmap, cve, web/WSTG, recon, discover) and the shared engine that backs the last two."/>
            <concept id="c2" label="WHAT IT IS"
                     long-comment="The one-paragraph answer to &#x27;what is this?&#x27; before any detail. Keep this section short; the rest of the map only makes sense once this is clear."/>
            <concept id="c3" label="a Go-first security toolkit with a Python escape hatch"
                     long-comment="Go is the core because it produces a single static binary, cross-compiles cleanly, and its stdlib covers HTTP/XML/JSON (the formats every agent speaks). Python is reserved for the few helpers Go can&#x27;t do tidily (desktop glue), reached via &#x27;hackbot py&#x27;. Alternative rejected: a pure Python tool is faster to prototype but harder to ship and test everywhere."/>
            <concept id="c4" label="github.com/rjwashi/hackbot (public, main)"
                     long-comment="The repo is public on purpose: the safety model should be auditable, not hidden. Docs, the agent registry, and the tool catalogs are kept honest by drift tests rather than by discipline."/>
            <concept id="c5" label="one binary: bin/hackbot.exe (go build -o bin/hackbot.exe .)"
                     long-comment="One binary with many subcommands keeps distribution trivial. Build locally with the command shown; CI also builds and runs tests (the -race run needs cgo, so it runs on the ubuntu runner, not on a bare Windows box)."/>
            <concept id="c6" label="PURPOSE"
                     long-comment="The north star. Every new agent is judged against these three lines."/>
            <concept id="c7" label="turn scans and checklists into prioritized, actionable findings"
                     long-comment="The product is a ranked, human-readable report, not raw tool noise. internal/nmap does this with rule-based analysis; internal/wstg does it by mapping each checklist test to a tool. Alternative rejected: dumping raw tool output is easier to build but shifts all the work to the reader."/>
            <concept id="c8" label="use only free / open-source tools"
                     long-comment="Anyone must be able to reproduce a run, so every catalog entry carries a license and an install hint. This is a hard rule enforced by catalog tests (every tool must declare a license and URL). Alternative rejected: paid feeds (Vulners etc.) are higher fidelity but not reproducible by users."/>
            <concept id="c9" label="never touch a system that is not explicitly authorized"
                     long-comment="Security tooling is dual-use. The whole safety model exists so hackbot cannot be aimed at arbitrary targets &#x27;by accident&#x27;. This is the single most important design constraint and the reason several features are deliberately manual."/>
            <concept id="c10" label="AGENT FAMILIES"
                     long-comment="hackbot is built from composable agents grouped into families. The registry in main.go is the single source of truth; &#x27;hackbot agents&#x27; prints it and tests keep docs/agents.md and the README snapshot in sync."/>
            <concept id="c11" label="nmap family (parse, analyze, recon, vulscan, pipeline, guarded scan)"
                     long-comment="The original family. It ingests nmap XML, produces a rule-based risk report, surfaces NSE recon and vulscan matches, and can run a guarded live scan. Ingest-first is the default mode so no traffic is sent unless asked."/>
            <concept id="c12" label="cve family (categories, search, keyword, scan)"
                     long-comment="Searches the free NIST NVD 2.0 API by category (pinned to CWEs), by free text, or by the software nmap fingerprinted. Read-only and key-free; an optional API key just raises the rate limit (5 -&gt; 50 req/30s)."/>
            <concept id="c13" label="web (WSTG) family (list, show, tools, plan, run)"
                     long-comment="Twelve agents, one per OWASP Web Security Testing Guide checklist under src/agent_files/. The checklist is the agent&#x27;s capability list; a curated layer maps each test to a free tool, and the automatable ones can run under guard. Non-automatable tests deliberately stay manual guidance."/>
            <concept id="c14" label="recon family (subdomains, dns, ports, services, http, whois, urls)"
                     long-comment="OSINT reconnaissance via subfinder, dnsx, naabu, nmap, httpx, whois, gau. It operates on DOMAIN NAMES, which the IP/CIDR allowlist deliberately refuses, which is exactly why the domain allowlist (allowed_domains) exists."/>
            <concept id="c15" label="discover family (dirs, files, extensions, vhosts, params)"
                     long-comment="Content discovery via ffuf and gobuster. Brute forcing is noisy by nature, so every task is guarded and dry-run by default, and it borrows a wordlist from config (defaulting to the free SecLists common list)."/>
            <concept id="c16" label="[planned] secrets, deps/SBOM, and cloud families"
                     long-comment="internal/ops generalizes the &#x27;catalog + guarded runner&#x27; pattern, so a new family is mostly a catalog file plus registry entries. Secrets (gitleaks/trufflehog) and dependency/SBOM (trivy/grype/osv-scanner) are the next planned families."/>
            <concept id="c17" label="CLI SURFACE"
                     long-comment="One binary, one verb per capability. Flags may appear anywhere on the line (a small reorder pass works around Go&#x27;s flag-before-positional rule, a recurring usability papercut)."/>
            <concept id="c18" label="hello · run · version · help · py"
                     long-comment="Scaffolding commands. &#x27;run&#x27; is the bot-loop scaffold; &#x27;py&#x27; is the Go-&gt;Python escape hatch used only where Go can&#x27;t do the job."/>
            <concept id="c19" label="agents · layout"
                     long-comment="&#x27;agents&#x27; renders the registry (text/markdown/json/skill); &#x27;layout&#x27; prints the repo tree. Both feed generated docs, so drift tests fail if the docs aren&#x27;t regenerated after a change."/>
            <concept id="c20" label="nmap parse · analyze · recon · vulscan · scan · pipeline"
                     long-comment="Ingestion verbs (parse/analyze/recon/vulscan/pipeline) never scan; only &#x27;scan&#x27; sends traffic and it is guarded."/>
            <concept id="c21" label="cve categories · search · keyword · scan"
                     long-comment="Read-only NVD queries; no network scanning at all."/>
            <concept id="c22" label="web list · show · tools · plan · run"
                     long-comment="&#x27;list/show&#x27; are pure reference; &#x27;tools/plan&#x27; show the free-tool mapping; &#x27;run&#x27; is the guarded executor (dry-run by default)."/>
            <concept id="c23" label="recon list · tools · plan · &lt;task&gt; &lt;target&gt;"
                     long-comment="Same shape as web: list/tools/plan are reference; the bare &#x27;&lt;task&gt; &lt;target&gt;&#x27; form is the common case and stays guarded."/>
            <concept id="c24" label="discover list · tools · plan · &lt;task&gt; &lt;target&gt;"
                     long-comment="Identical shape to recon, backed by the same engine, so muscle memory carries between families."/>
            <concept id="c25" label="CODE MAP (internal/)"
                     long-comment="Small, single-purpose packages. Each owns one concern and exposes a narrow surface; main.go is the only place that composes them."/>
            <concept id="c26" label="config/"
                     long-comment="JSON file + HACKBOT_* env overrides -&gt; Config struct. Env wins so deployments can override without editing files."/>
            <concept id="c27" label="bot/"
                     long-comment="The core bot loop (greet/tick/done) and the RunPython bridge; the scaffold future scheduling will hang off."/>
            <concept id="c28" label="nmap/"
                     long-comment="nmap XML parsing plus the rule-based Analyze() producing []Finding (ranked worst-first)."/>
            <concept id="c29" label="scan/ (+ scope.go)"
                     long-comment="The guarded process runner (CommandRunner seam) and the scope checks: InScope (IP/CIDR), DomainInScope (names), PathInScope (future local scans)."/>
            <concept id="c30" label="agent/"
                     long-comment="The nmap pipeline: analyze -&gt; [LLM narrative] -&gt; [GitHub issues]; owns the Report type."/>
            <concept id="c31" label="cve/"
                     long-comment="NVD 2.0 client behind a one-method Searcher interface, so extra sources (OSV, GHSA) can drop in later."/>
            <concept id="c32" label="vulscan/"
                     long-comment="Parses vulscan (VulDB) NSE output into potential CVE matches; conservative on purpose (offline data, unconfirmed)."/>
            <concept id="c33" label="wstg/ (+ capability.go, run.go)"
                     long-comment="Parses/embeds the WSTG checklists, holds the free-tool catalog and curated checks, and runs them under guard."/>
            <concept id="c34" label="ops/ (+ runner.go, recon.go, discovery.go)"
                     long-comment="The general capability engine: Tool/Task/Catalog + a guarded Runner. recon and discover are just catalogs on top; future families reuse it."/>
            <concept id="c35" label="DATA FLOW"
                     long-comment="How data becomes findings. &#x27;→&#x27; marks transformation; [ ] marks optional stages."/>
            <concept id="c36" label="nmap XML (or guarded scan) → parse → analyze → []Finding"
                     long-comment="Either you produce the XML yourself, or hackbot runs a guarded scan; both funnel into the same parser so downstream stages don&#x27;t care about the source."/>
            <concept id="c37" label="[]Finding → [LLM narrative] → [GitHub issues, dry-run]"
                     long-comment="The optional LLM turns ranked findings into prose; issue filing is dry-run until explicitly enabled with -dry-run=false."/>
            <concept id="c38" label="WSTG checklist → capability (test→tool) → plan / guarded run"
                     long-comment="The checklist supplies the tests; the capability layer supplies the commands; the runner supplies the safety."/>
            <concept id="c39" label="domain → recon task → tool stdout"
                     long-comment="e.g. subfinder -d &lt;domain&gt; -&gt; lines of subdomains. Output is evidence, not a verdict."/>
            <concept id="c40" label="URL → discovery task → ffuf/gobuster stdout"
                     long-comment="e.g. ffuf -u &lt;url&gt;/FUZZ -&gt; discovered paths. Noisy by nature, hence guarded."/>
            <concept id="c41" label="SAFETY MODEL"
                     long-comment="The rules that make a dual-use tool safe to ship. Every family must obey all of them."/>
            <concept id="c42" label="execution is DISABLED by default (enable_scan)"
                     long-comment="Nothing runs (network or local) until enable_scan / HACKBOT_ENABLE_SCAN is set. Alternative rejected: &#x27;read-only is always safe&#x27; is false once a tool can clone remote repos."/>
            <concept id="c43" label="an allowlist is REQUIRED (allowed_targets IP/CIDR; allowed_domains names)"
                     long-comment="A target must be inside the relevant allowlist before a real run. IPs and domains are separate lists because allowing a CIDR is not consent to hit every domain that resolves into it."/>
            <concept id="c44" label="actions are DRY-RUN by default (web run, recon, discover, issues)"
                     long-comment="The default is to render the exact command and send nothing. You opt in with -dry-run=false. This makes the safe path also the informative path."/>
            <concept id="c45" label="ingestion is the default mode"
                     long-comment="parse/analyze/recon/vulscan/pipeline and all web/plan commands read data and never scan, so the tool is useful with zero scanning enabled."/>
            <concept id="c46" label="fixed argument templates (targets are never shell-interpolated)"
                     long-comment="Commands are stored as argv arrays with placeholders; the target becomes one argv element, never a shell fragment. This removes an entire class of injection bugs."/>
            <concept id="c47" label="the runner is the authoritative gate"
                     long-comment="The CLI pre-checks for a friendly message, but the runner re-checks enable + scope itself, so a new caller cannot bypass the guards by forgetting them."/>
            <concept id="c48" label="CONFIGURATION"
                     long-comment="One optional JSON file, overridable by environment. Env wins so CI/hosted runs need no file."/>
            <concept id="c49" label="-config hackbot.json (see hackbot.example.json)"
                     long-comment="The example file documents every key; absent file means defaults (scanning off)."/>
            <concept id="c50" label="HACKBOT_* env vars override the file"
                     long-comment="Same values, deployable without shipping a file. Truthy parsing accepts 1/true/yes/on."/>
            <concept id="c51" label="allowed_domains and wordlist (recon/discover)"
                     long-comment="allowed_domains gates name-based recon; wordlist feeds content discovery (defaults to the free SecLists common list)."/>
            <concept id="c52" label="QUALITY"
                     long-comment="How correctness is protected as the project grows."/>
            <concept id="c53" label="Go tests per package (table-driven)"
                     long-comment="Each package carries focused tests; the safety-critical paths (scope, runner gates) are tested with fakes so they run with no network and no tools installed."/>
            <concept id="c54" label="Python tests (pytest over pythontools/)"
                     long-comment="The escape-hatch helpers are tested too, since they run in the same product."/>
            <concept id="c55" label="CI: gofmt + vet + build + test -race + pytest"
                     long-comment="Formatting, vetting, race testing, and the Python suite all gate every push/PR."/>
            <concept id="c56" label="drift tests keep registry, docs, and catalogs in sync"
                     long-comment="Adding a checklist/agent without updating docs fails the build. This is why the generated tables in the README and docs never rot."/>
            <concept id="c57" label="ROADMAP"
                     long-comment="Planned next steps. &#x27;[ ]&#x27; marks not-done; these mirror the recommendations in docs/agents.md."/>
            <concept id="c58" label="[ ] secrets scanning (gitleaks, trufflehog)"
                     long-comment="Local/repo secret detection. Reuses the ops engine with a path target kind; read-only."/>
            <concept id="c59" label="[ ] dependency / SBOM (trivy, grype, osv-scanner)"
                     long-comment="SCA over a project directory; produces CycloneDX and prioritized vulns. Reuses ops."/>
            <concept id="c60" label="[ ] cloud posture (prowler)"
                     long-comment="Cloud account auditing. Needs a cloud-account allowlist and credentials, so it gets its own careful gate."/>
            <concept id="c61" label="[ ] recon → discover chaining"
                     long-comment="Feed recon output (subdomains, live hosts) into discovery so one allowlisted seed expands into a full footprint."/>
            <concept id="c62" label="[ ] generate OpenCode skills from agents"
                     long-comment="Each registry entry is already skill-shaped; &#x27;hackbot agents -format skill&#x27; scaffolds them."/>
            <concept id="c63" label="[ ] vulscan → NVD enrichment; EPSS/KEV; SARIF/CycloneDX"
                     long-comment="Attach CVSS/EPSS/KEV to vulscan CVEs, rank by exploitation likelihood, and export CI-friendly formats."/>
            <concept id="c64" label="MIND MAP META"
                     long-comment="How to read and maintain this map."/>
            <concept id="c65" label="CXL (CmapTools) is the map of record; .txt mirrors it"
                     long-comment="Edges are propositions: concept -&gt; linking phrase -&gt; concept. Open the .cxl in CmapTools (File -&gt; Open)."/>
            <concept id="c66" label="long-comments explain the &#x27;why&#x27; and the rejected alternatives"
                     long-comment="Most concepts carry a long-comment explaining the reasoning, not just the label, so the map teaches the design."/>
            <concept id="c67" label="one version per milestone; older versions stay for history"
                     long-comment="v1 captured the nmap milestone; v2 captures the five-family project; a future final-annotated pass can expand every concept for a newcomer."/>
        </concept-list>

